# Copy to .env and `set -a; source .env; set +a` (or use `make`).
DBT_TARGET=postgres
DBT_ENV=dev
DBT_SCHEMA=dbt_dev
DBT_RAW_SCHEMA=raw
DBT_PII_SALT=local-dev-only-salt

# Postgres (docker)
PG_HOST=localhost
PG_PORT=5432
PG_USER=dbt
PG_PASSWORD=dbt_local_pw
PG_DATABASE=analytics

# SQL Server (docker)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Dbt_local_pw1
MSSQL_DATABASE=analytics
MSSQL_TRUST_CERT=true

# Oracle (docker) - schema == user
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=dbt
ORACLE_PASSWORD=dbt_local_pw

# Snowflake (key-pair auth)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=ANALYTICS

# Databricks (OAuth M2M service principal)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=analytics
